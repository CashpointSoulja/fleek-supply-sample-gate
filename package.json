    "evals": "tsx eval/run-evals.ts"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  }
}

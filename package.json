{
  "name": "fleek-supply-sample-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Independent concept: a sample-to-first-order decision desk for new supply in a category bet. Not an official Fleek product.",
  "scripts": {
